   ],
   "parameters": {
    "jsCode": "// Round-robin: pick the next agent based on how many leads already exist.\nconst AGENTS = [\n  { name: 'مستشار ١', telegram_chat_id: 'PUT_CHAT_ID_1' },\n  { name: 'مستشار ٢', telegram_chat_id: 'PUT_CHAT_ID_2' },\n  { name: 'مستشار ٣', telegram_chat_id: 'PUT_CHAT_ID_3' },\n];\nconst total = $('Count leads').all().length;            // rows already in the sheet\nconst lead = $('Normalize & validate').first().json;\nconst agent = AGENTS[total % AGENTS.length];\nreturn [{ json: { ...lead, status: 'جديد', agent: agent.name, agent_chat: agent.telegram_chat_id } }];"
   }
  },
