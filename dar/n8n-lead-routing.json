 "nodes": [
  {
   "id": "2e990d74-2fda-4c55-9392-000f8638027e",
   "name": "Lead webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    300
   ],
   "parameters": {
    "httpMethod": "POST",
    "path": "dar-leads",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "https://tahawi0.github.io"
    }
   },
   "webhookId": "b534b60e-3c63-4933-a68d-a13773b4c6ac"
  },
  {
   "id": "288e50d4-5ce2-4773-ba8d-54d0bca993ee",
   "name": "Normalize & validate",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    300
   ],
   "parameters": {
    "jsCode": "// Validate + normalize leads coming from Mada View and Dar Brokers forms.\n// Browser forms can't hold a secret, so we rely on strict validation + a honeypot + allowed origin.\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || item.json;\n  const name = String(b.name || '').trim().slice(0, 80);\n  let phone = String(b.phone || '').replace(/\\D/g, '');\n  if (phone.startsWith('20')) phone = '0' + phone.slice(2);\n  const honeypot = String(b.website || '').trim();\n  const valid = name.length >= 2 && /^01[0125]\\d{8}$/.test(phone) && !honeypot;\n  const source = ['mada-view-landing', 'dar-brokers-site'].includes(b.source) ? b.source : 'unknown';\n  out.push({ json: {\n    valid,\n    lead_id: 'L-' + Date.now().toString(36),\n    received_at: new Date().toISOString(),\n    source,\n    project: source === 'mada-view-landing' ? 'مدى ڤيو' : (b.unit_id || '').startsWith('mada-') ? 'مدى ڤيو' : 'ريسيل/دار',\n    name, phone, phone_intl: '+2' + phone,\n    unit: String(b.unit || '').slice(0, 80),\n    budget: String(b.budget || '').slice(0, 40),\n    contact_time: String(b.time || '').slice(0, 30),\n    monthly_from_calc: b.calc && b.calc.monthly ? Number(b.calc.monthly) : '',\n  }});\n}\nreturn out;"
   }
  },
  {
   "id": "9150a357-f174-4fd6-a3ac-6bd8cdfd45da",
   "name": "Valid?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    440,
    300
   ],
   "parameters": {
    "conditions": {
